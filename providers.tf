terraform {
  required_version = ">= 1.7.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # Uncomment when deploying with remote state in AWS:
  # backend "s3" {
  #   bucket         = "shan-bilal-terraform-state"
  #   key            = "aws-vpc-ec2/terraform.tfstate"
  #   region         = "eu-central-1"
  #   dynamodb_table = "terraform-state-locks"
  #   encrypt        = true
  # }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "Terraform"
    }
  }
}
